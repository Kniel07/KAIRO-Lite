# KAIRO-Lite Environment Variables
# See Document 11 (Security & Authentication) §9 for the authoritative list.
# Never commit a real .env file — only this .env.example template.

# --- Database (Document 3, Document 10) ---
DATABASE_URL="postgresql://user:password@localhost:5432/kairo_lite?schema=public"

# --- Auth.js v5 (Document 11 §3, §9) ---
AUTH_SECRET="generate-with-npx-auth-secret"
AUTH_URL="http://localhost:3000"

# --- Resend — magic-link email delivery (Document 11 §4) ---
RESEND_API_KEY=""

# --- Single-user MVP gate (Document 11 §10) ---
KAIRO_OWNER_EMAIL=""

# --- AI Orchestrator (Document 4, Document 12) ---
OPENAI_API_KEY=""
